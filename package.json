{
  "name": "ln-tabular-recipes-dsl",
  "version": "0.1.0",
  "description": "Tabular recipes: a Mermaid-like DSL, a tree model, validation and a rowspan/colspan table layout + HTML renderer. Zero runtime dependencies.",
  "keywords": [
    "recipe",
    "tabular-recipe",
    "cooking",
    "dsl",
    "parser",
    "mermaid",
    "obsidian"
  ],
  "license": "MIT",
  "author": "Grégory Lecomte",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gallad51/LNTabularRecipesDSL.git"
  },
  "homepage": "https://github.com/Gallad51/LNTabularRecipesDSL#readme",
  "bugs": {
    "url": "https://github.com/Gallad51/LNTabularRecipesDSL/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "SPEC.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup && node scripts/copy-css.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "demo": "npm run build && node scripts/demo.mjs",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.10.0",
    "tsup": "^8.5.1",
    "typescript": "~5.9",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
